{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": [
		"@engineering-sandbox/tsconfig-base/src/tsconfig.base.json",
		"@engineering-sandbox/tsconfig-base/src/tsconfig.paths.json"
	],
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "es2023",
		"lib": ["ES2023", "DOM"],
		"module": "esnext",
		"types": ["vite/client"],
		"skipLibCheck": true,
		"paths": {
			"@/*": ["./src/*"],
			"@engineering-sandbox/ui/*": ["../../packages/ui/src/*"]
		},

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx"
	},
	"include": ["src"]
}
