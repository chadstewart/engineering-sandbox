{
	"name": "@engineering-sandbox/ui",
	"version": "0.0.0",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		"./globals.css": "./dist/styles/globals.css",
		"./components/*": "./src/components/*",
		"./lib/utils": "./src/lib/utils.ts",
		"./*": "./dist/*.js"
	},
	"license": "MIT",
	"scripts": {
		"build:styles": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles/globals.css",
		"build:components": "tsc",
		"check-types": "tsc --noEmit",
		"dev:styles": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles/globals.css --watch",
		"dev:components": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest --watch"
	},
	"dependencies": {
		"@engineering-sandbox/tsconfig-base": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.21.0",
		"radix-ui": "^1.6.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"shadcn": "^4.11.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@engineering-sandbox/tailwind-base": "workspace:*",
		"@engineering-sandbox/vitest-config": "workspace:*",
		"@storybook/nextjs-vite": "^10.5.2",
		"@tailwindcss/cli": "^4.3.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"storybook": "^10.4.6",
		"tailwindcss": "^4.3.1",
		"typescript": "7.0.2",
		"vitest": "^4.1.10"
	}
}
