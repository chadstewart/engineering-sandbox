{
	"extends": "@engineering-sandbox/tsconfig-base/src/tsconfig.base.json",
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"composite": false,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"inlineSources": false,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"preserveWatchOutput": true,
		"skipLibCheck": true,
		"paths": {
			"@engineering-sandbox/ui/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": ["dist", "build", "node_modules"]
}
