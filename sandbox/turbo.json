{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", "storybook-static/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"transit": {
			"dependsOn": ["^transit"]
		},
		"test": {
			"dependsOn": ["transsit", "@engineering-sandbox/vitest-config#build"],
			"outputs": ["coverage/blob/**"]
		},
		"test:watch": {
			"cache": false,
			"persistent": true
		},

		"//#format-and-lint": {},
		"//#format-and-lint:fix": {
			"cache": false
		}
	}
}
